    "sec-turb-intro": {
      "title": "অস্থির প্রবাহ কী?",
      "audio_file": "sec_01_sec-turb-intro.mp3",
      "total_duration_ms": 22415.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "অস্থির প্রবাহ কী?।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "নলের ভেতর ধীরে বয়ে চলা জল সুষম — সব স্তর একদিকে এগোয়। কিন্তু বেগ বাড়ালে হঠাৎ করে জল ঘুর্ণায়মান হয়ে যায়, ছোট ছোট পাক তৈরি হয় — এটি অস্থির প্রবাহ বা turbulence। বিজ্ঞানীদের প্রশ্ন ছিল: বড় ভর্টেক্সগুলোর শক্তি কোথায় যায়? উত্তর — সেটি ক্রমাগত ছোট ছোট ভর্টেক্সে ভেঙে যায়।",
          "start_ms": 2850.0,
          "end_ms": 18030.0,
          "duration_ms": 15180.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, বড় ভর্টেক্স থেকে ছোট ভর্টেক্সে শক্তির ক্যাসকেড",
          "start_ms": 18380.0,
          "end_ms": 22065.0,
          "duration_ms": 3685.0
        }
      ]
    },
    "sec-turb-cascade": {
      "title": "শক্তির ক্যাসকেড",
      "audio_file": "sec_02_sec-turb-cascade.mp3",
      "total_duration_ms": 33810.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "শক্তির ক্যাসকেড।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "রিচার্ডসনের কবিতা মনে আছে? 'Big whorls have little whorls / Which feed on their velocity…' — বড় ঘুর্ণি ছোট ঘুর্ণিকে খাওয়ায়, আবার ছোটটি আরও ছোটটিকে। এই ধাপে ধাপে শক্তি স্থানান্তরকে বলা হয় <strong>energy cascade</strong>। সবশেষে খুব ছোট স্কেলে সান্দ্রতা শক্তিকে তাপ হিসেবে শোষণ করে।",
          "start_ms": 2850.0,
          "end_ms": 18470.0,
          "duration_ms": 15620.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, বড় → মাঝারি → ছোট → তাপ: ক্যাসকেডের ধাপ",
          "start_ms": 18820.0,
          "end_ms": 22120.0,
          "duration_ms": 3300.0
        },
        {
          "index": 3,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: শক্তি স্থানান্তর হার।",
          "start_ms": 22470.0,
          "end_ms": 24970.0,
          "duration_ms": 2500.0
        },
        {
          "index": 4,
          "type": "callout",
          "text": "বিশেষ নোট: যান্ত্রিক অনুভূতি। যেমন একটা বড় জলের স্রোত ভেঙে ছোট ছোট পাক দেয়, তেমনি শক্তিও আকারে ছোট হয়ে নিচে নামে — যতক্ষণ না তাপে রূপান্তরিত হয়।",
          "start_ms": 25320.0,
          "end_ms": 33460.0,
          "duration_ms": 8140.0
        }
      ]
    },
    "sec-turb-kolmogorov": {
      "title": "কোলমোগোরভের -৫/৩ সূত্র",
      "audio_file": "sec_03_sec-turb-kolmogorov.mp3",
      "total_duration_ms": 26255.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "কোলমোগোরভের -৫/৩ সূত্র।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "১৯৪১ সালে আন্দ্রেই কোলমোগোরভ দেখালেন যে মাঝারি আকারের ভর্টেক্সের ক্ষেত্রে শক্তি বর্ণালী নির্ভর করে শুধু দুটি জিনির ওপর — শক্তি-স্থানান্তর হার epsilon ও তরঙ্গসংখ্যা k। মাত্রা বিশ্লেষণ থেকে পাওয়া যায় E(k) ∝ epsilon^(2/3) k^(-5/3)।এই -5/3 ঘাতটা বাস্তব পর্যবেক্ষণে অত্যন্ত সঠিকভাবে মেলে — তাই এটি একটি মৌলিক ধ্রুবক।",
          "start_ms": 2850.0,
          "end_ms": 20065.0,
          "duration_ms": 17215.0
        },
        {
          "index": 2,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: কোলমোগোরভ স্পেকট্রাম।",
          "start_ms": 20415.0,
          "end_ms": 22915.0,
          "duration_ms": 2500.0
        },
        {
          "index": 3,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, লগ-লগ গ্রাফে -5/3 ঢালের রেখা",
          "start_ms": 23265.0,
          "end_ms": 25905.0,
          "duration_ms": 2640.0
        }
      ]
    },
    "sec-turb-universality": {
