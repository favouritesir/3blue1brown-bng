        {
          "index": 0,
          "type": "h2",
          "text": "হারানো বক্তৃতার গল্প।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "১৯৬৪ সালে রিচার্ড ফাইনম্যান ক্যালিফোর্নিয়ায় এক বক্তৃতা দিয়েছিলেন — কেন গ্রহের কক্ষপথ একটি উপবৃত্ত হয়। সেই বক্তৃতার নিজস্ব নোট হারিয়ে যাওয়ায় পরে বিখ্যাত হয়ে ওঠে 'ফাইনম্যানের হারানো বক্তৃতা' নামে। এই ভিডিওতে সেই যুক্তিটি পুনর্নির্মাণ করা হয়েছে — আর এতে কোনো জটিল ক্যালকুলাস নেই।",
          "start_ms": 2850.0,
          "end_ms": 18525.0,
          "duration_ms": 15675.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, সূর্যের চারপাশে একটি উপবৃত্তাকার কক্ষপথ",
          "start_ms": 18875.0,
          "end_ms": 22120.0,
          "duration_ms": 3245.0
        }
      ]
