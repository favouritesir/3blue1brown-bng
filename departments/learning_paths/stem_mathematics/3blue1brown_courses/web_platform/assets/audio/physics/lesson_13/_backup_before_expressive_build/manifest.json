    "sec-snell-meaning": {
      "title": "অন্তর্দৃষ্টি",
      "audio_file": "sec_04_sec-snell-meaning.mp3",
      "total_duration_ms": 23735.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "অন্তর্দৃষ্টি।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "এই মডেলের সুন্দর দিক হলো এটি স্নেলের সূত্রকে আকৃতি দেয়। প্রতিসরাংককে এখন আর শুধু 'বেগের অনুপাত' হিসেবে নয়, বরং মাধ্যমের কণাগুলো কতটা শক্তভাবে আবদ্ধ তা হিসেবে দেখা যায়। একই ধরনের ভারসাম্য-চিন্তা অনেক পদার্থবৈজ্ঞানিক সূত্রের পেছনে কাজ করে।",
          "start_ms": 2850.0,
          "end_ms": 16050.0,
          "duration_ms": 13200.0
        },
        {
          "index": 2,
          "type": "callout",
          "text": "বিশেষ নোট: শিক্ষণীয়। জটিল সূত্রকেও সহজ যান্ত্রিক মডেল দিয়ে বোঝা যায় — সঠিক সাদৃশ্য খুঁজে পেলে গণিত স্বয়ংক্রিয়ভাবে ফল দেয়।",
          "start_ms": 16400.0,
          "end_ms": 23385.0,
          "duration_ms": 6985.0
        }
      ]
