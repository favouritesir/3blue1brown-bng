      "total_duration_ms": 23945.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "সূত্রের উদ্ভব।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "ধরা যাক সীমানায় দুইটি কণা আছে — একটির স্প্রিং ধ্রুবক k₁, অন্যটির k₂। কোণ θ₁ ও θ₂ হলে স্প্রিংগুলোর সীমানা-বরাবর সরণ sinθ₁ ও sinθ₂-এর সমানুপাতিক। ভারসাম্যের শর্ত দেয় k₁sinθ₁ = k₂sinθ₂। স্প্রিং ধ্রুবকের সাথে প্রতিসরাংকের সম্পর্ক স্থাপন করলেই পাই স্নেলের সূত্র।",
          "start_ms": 2850.0,
          "end_ms": 17095.0,
          "duration_ms": 14245.0
        },
        {
          "index": 2,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: স্প্রিং থেকে স্নেল।",
          "start_ms": 17445.0,
          "end_ms": 19945.0,
          "duration_ms": 2500.0
        },
        {
          "index": 3,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, বলের ভারসাম্য থেকে স্নেলের সূত্রের উদ্ভব",
          "start_ms": 20295.0,
          "end_ms": 23595.0,
