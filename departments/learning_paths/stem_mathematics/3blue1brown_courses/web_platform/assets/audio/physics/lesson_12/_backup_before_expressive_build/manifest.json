  "sections": {
    "sec-brach-intro": {
      "title": "প্রশ্নটি কী?",
      "audio_file": "sec_01_sec-brach-intro.mp3",
      "total_duration_ms": 24890.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "প্রশ্নটি কী?।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "১৬৯৬ সালে জোহান বার্নুলি এক ক্লাসিক প্রশ্ন তুলেছিলেন: মাধ্যাকর্ষণের অধীনে একটি বলকে A বিন্দু থেকে B বিন্দুতে (B নিচে ও পাশে) কোন পথ দিয়ে পাঠালে সবচেয়ে কম সময়ে পৌঁছাবে? সরল রেখা সবচেয়ে ছোট পথ, কিন্তু সেটি সবচেয়ে দ্রুত নয় — কারণ শুরুতে বলের বেগ কম। একটু নিচে নামলে বেগ বাড়ে, তাই একটা বাঁকা পথ আসলে দ্রুত হতে পারে।",
          "start_ms": 2850.0,
          "end_ms": 20340.0,
          "duration_ms": 17490.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, দুই বিন্দুর মাঝে সরল রেখা বনাম বাঁকা সাইক্লয়েড পথ",
          "start_ms": 20690.0,
          "end_ms": 24540.0,
          "duration_ms": 3850.0
        }
      ]
    },
    "sec-brach-light": {
      "title": "বার্নুলির আলোর কৌশল",
      "audio_file": "sec_02_sec-brach-light.mp3",
      "total_duration_ms": 34360.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "বার্নুলির আলোর কৌশল।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "বার্নুলির প্রতিভা ছিল এই প্রশ্নটিকে আলোর প্রতিসরণের সাথে মিলিয়ে দেওয়া। ফার্মাটের নীতি বলে আলো সবচেয়ে কম সময়ে পৌঁছানোর পথ বেছে নেয়। আবার মাধ্যাকর্ষণে বলের বেগ v = √(2gy) — নিচে যত যায় বেগ তত বাড়ে। ঠিক যেন আলো এমন মাধ্যমে চলছে যার প্রতিসরাংক নিচের দিকে কমে যাচ্ছে। তাই স্নেলের সূত্র প্রয়োগ করা যায়।",
          "start_ms": 2850.0,
          "end_ms": 19625.0,
          "duration_ms": 16775.0
        },
        {
          "index": 2,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: স্নেলের সূত্রের সাদৃশ্য।",
          "start_ms": 19975.0,
          "end_ms": 22475.0,
          "duration_ms": 2500.0
        },
        {
          "index": 3,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, স্তরবদ্ধ মাধ্যমে আলোর পথ ও ব্রাকিস্টোক্রনের সাদৃশ্য",
          "start_ms": 22825.0,
          "end_ms": 26730.0,
          "duration_ms": 3905.0
        },
        {
          "index": 4,
          "type": "callout",
          "text": "বিশেষ নোট: কেন আলো?। আলোর পথ ও দ্রুততম পথ — দুটোই 'সবচেয়ে কম সময়' নীতি অনুসরণ করে। বার্নুলি এই গভীর মিলটি আবিষ্কার করেছিলেন।",
          "start_ms": 27080.0,
          "end_ms": 34010.0,
          "duration_ms": 6930.0
        }
      ]
    },
    "sec-brach-cycloid": {
      "title": "উত্তর — সাইক্লয়েড",
      "audio_file": "sec_03_sec-brach-cycloid.mp3",
      "total_duration_ms": 25265.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "উত্তর — সাইক্লয়েড।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "স্নেলের সূত্রকে ধাপে ধাপে প্রয়োগ করে বার্নুলি পেলেন যে পথটি হলো <strong>সাইক্লয়েড (cycloid)</strong> — একটি চাকা সোজা রাস্তায় গড়িয়ে গেলে তার প্রান্তবিন্দু যে তরঙ্গ-মতো পথে চলে, সেটি। এই পথে প্রথমে তীব্র নামা, তারপর সোজা হওয়া — ফলে বল দ্রুত বেগ অর্জন করে সময় বাঁচায়।",
          "start_ms": 2850.0,
          "end_ms": 17865.0,
          "duration_ms": 15015.0
        },
        {
          "index": 2,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: সাইক্লয়েড।",
          "start_ms": 18215.0,
          "end_ms": 20715.0,
          "duration_ms": 2500.0
        },
        {
          "index": 3,
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, গড়িয়ে চলা চাকার বিন্দু থেকে সাইক্লয়েডের উৎপত্তি",
          "start_ms": 21065.0,
          "end_ms": 24915.0,
          "duration_ms": 3850.0
        }
      ]
    },
    "sec-brach-legacy": {
      "title": "ক্যালকুলাসের জন্ম",
      "audio_file": "sec_04_sec-brach-legacy.mp3",
      "total_duration_ms": 22085.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "ক্যালকুলাসের জন্ম।",
          "start_ms": 0.0,
          "end_ms": 2500.0,
          "duration_ms": 2500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "এই এক প্রশ্নের সমাধানে নিউটন, লাইবনিৎজ ও বার্নুলি ভাইয়েরা সবাই অংশ নিয়েছিলেন — আর সেই থেকেই variational calculus-এর ভিত্তি পড়ে। পরবর্তীতে আলোর সাদৃশ্য আরও অনেক সমস্যার চাবিকাঠি হয়ে ওঠে।",
          "start_ms": 2850.0,
          "end_ms": 13245.0,
          "duration_ms": 10395.0
        },
        {
          "index": 2,
          "type": "callout",
          "text": "বিশেষ নোট: ঐতিহাসিক তাৎপর্য। ব্রাকিস্টোক্রন ছিল প্রথম দিকনির্দেশক সমস্যা যা গণিতবিদদের এক নতুন ভাষা — ক্যালকুলাস অফ ভেরিয়েশন — আবিষ্কারে ঠেলে দেয়।",
          "start_ms": 13595.0,
          "end_ms": 21735.0,
          "duration_ms": 8140.0
        }
      ]
    }
  }
