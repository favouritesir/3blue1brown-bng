    "sec-hanoi": {
      "title": "১. হ্যানয়ের টাওয়ার",
      "audio_file": "sec_01_sec-hanoi.mp3",
      "total_duration_ms": 31400.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "১. হ্যানয়ের টাওয়ার",
          "start_ms": 0.0,
          "end_ms": 3760.0,
          "duration_ms": 3760.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "তিনটি দণ্ড—প্রথমটিতে ছোট থেকে বড় করে কয়েকটি চাকতি সাজানো। লক্ষ্য হলো সবগুলো চাকতি তৃতীয় দণ্ডে নিয়ে যাওয়া, কিন্তু কখনো বড় চাকতি ছোটের ওপর রাখা যাবে না। একবারে একটি করে চাকতি নাড়া যায়।",
          "start_ms": 4110.0,
          "end_ms": 18110.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "হ্যানয়ের টাওয়ার—তিন দণ্ড ও চাকতি",
          "start_ms": 18460.0,
          "end_ms": 23312.0,
          "duration_ms": 4852.0
        },
        {
          "index": 3,
          "type": "callout",
          "text": "$n$টি চাকতির জন্য ন্যূনতম কত পদক্ষেপ লাগে? আর সেই পদক্ষেপগুলোর ক্রম কী?",
          "start_ms": 23662.0,
          "end_ms": 31400.0,
          "duration_ms": 7738.0
        }
      ]
    },
    "sec-binary": {
      "title": "২. বাইনারি গণনার রহস্য",
      "audio_file": "sec_02_sec-binary.mp3",
      "total_duration_ms": 38084.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "২. বাইনারি গণনার রহস্য",
          "start_ms": 0.0,
          "end_ms": 3916.0,
          "duration_ms": 3916.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "অবিশ্বাস্যভাবে, পদক্ষেপের ক্রম বের করা যায় ০ থেকে শুরু করে বাইনারিতে গণনা করে। $i$-তম পদক্ষেপে $i$-র বাইনারি রূপের সবচেয়ে ''ডানে থাকা ১'' যে বিটে, ঠিক সেই নম্বরের চাকতিটি নাড়তে হয়।",
          "start_ms": 4266.0,
          "end_ms": 18266.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র।",
          "start_ms": 18616.0,
          "end_ms": 21908.0,
          "duration_ms": 3292.0
        },
        {
          "index": 3,
          "type": "figure",
          "text": "বাইনারি গণনা ও হ্যানয়ের পদক্ষেপের মিল",
          "start_ms": 22258.0,
          "end_ms": 27422.0,
          "duration_ms": 5164.0
        },
        {
          "index": 4,
          "type": "p",
          "text": "এইভাবে ০, ১, ২, ৩… গণনা করলেই চাকতি নাড়ার সম্পূর্ণ সঠিক ক্রম পাওয়া যায়—কোনো পুনরাবৃত্ত চিন্তা ছাড়াই।",
          "start_ms": 27772.0,
          "end_ms": 38084.0,
          "duration_ms": 10312.0
        }
      ]
    },
    "sec-recursive": {
      "title": "৩. পুনরাবৃত্তিমূলক কাঠামো",
      "audio_file": "sec_03_sec-recursive.mp3",
      "total_duration_ms": 36112.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "৩. পুনরাবৃত্তিমূলক কাঠামো",
          "start_ms": 0.0,
          "end_ms": 4150.0,
          "duration_ms": 4150.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "$n$টি চাকতি সরাতে—প্রথমে ওপরের $n-1$টি তৃতীয় দণ্ডে নাড়া হয়, তারপর বড় চাকতিটি মাঝখানে, তারপর আবার $n-1$টি ওপরে। তাই $T(n)=2T(n-1)+1$।",
          "start_ms": 4500.0,
          "end_ms": 17308.0,
          "duration_ms": 12808.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "পুনরাবৃত্তিমূলক পদক্ষেপ—বড় চিত্রের ভেতরে ছোট চিত্র",
          "start_ms": 17658.0,
          "end_ms": 23836.0,
          "duration_ms": 6178.0
        },
        {
          "index": 3,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র।",
          "start_ms": 24186.0,
          "end_ms": 27478.0,
          "duration_ms": 3292.0
        },
        {
          "index": 4,
          "type": "chapter-quote",
          "text": "হ্যানয়ের টাওয়ার হলো পুনরাবৃত্তির এক সুন্দর ফল—গাণিতিক কাঠামো চোখে দেখা যায়।",
          "start_ms": 27828.0,
          "end_ms": 36112.0,
          "duration_ms": 8284.0
        }
      ]
    },
    "sec-sierpinski": {
      "title": "৪. সারপিনস্কি ত্রিভুজ",
      "audio_file": "sec_04_sec-sierpinski.mp3",
      "total_duration_ms": 35534.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "৪. সারপিনস্কি ত্রিভুজ",
          "start_ms": 0.0,
          "end_ms": 3838.0,
          "duration_ms": 3838.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "এই পুনরাবৃত্তিটি যদি চিত্রে আঁকি—বড় ত্রিভুজের ভেতরে তিনটি ছোট ত্রিভুজ, আবার প্রতিটির ভেতরে তিনটি—তবে পাই ''সারপিনস্কি ত্রিভুজ''। একই কাঠামো বারবার নিজের ভেতরে ফিরে আসে।",
          "start_ms": 4188.0,
          "end_ms": 18188.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "সারপিনস্কি ত্রিভুজ—পুনরাবৃত্তির আকৃতি",
          "start_ms": 18538.0,
          "end_ms": 23624.0,
          "duration_ms": 5086.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "হ্যানয়ের পদক্ষেপের ক্রমকে বাইনারি গ্রিডে সাজালেও ঠিক এই ফ্র্যাক্টাল চিত্রটি ফুটে ওঠে—দুটি বিষয় আসলে একই গাণিতিক বস্তু।",
          "start_ms": 23974.0,
          "end_ms": 35534.0,
          "duration_ms": 11560.0
        }
      ]
    },
    "sec-connection": {
      "title": "৫. বাইনারি, ধাঁধা ও ফ্র্যাক্টাল",
      "audio_file": "sec_05_sec-connection.mp3",
      "total_duration_ms": 32180.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "৫. বাইনারি, ধাঁধা ও ফ্র্যাক্টাল",
          "start_ms": 0.0,
          "end_ms": 4618.0,
          "duration_ms": 4618.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "বাইনারি গণনা, হ্যানয়ের টাওয়ার ও সারপিনস্কি ত্রিভুজ—তিনটি আলাদা মনে হলেও একই ''দ্বিঘাত পুনরাবৃত্তি''র তিন রূপ। কম্পিউটার বিজ্ঞানে এরকম সংযোগ বারবার দেখা যায়।",
          "start_ms": 4968.0,
          "end_ms": 18968.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "তিন রূপ—এক কাঠামো",
          "start_ms": 19318.0,
          "end_ms": 22844.0,
          "duration_ms": 3526.0
        },
        {
          "index": 3,
          "type": "callout",
          "text": "সরল নিয়মের বারবার প্রয়োগ জটিল ও সুন্দর কাঠামো তৈরি করে—এটি কম্পিউটার বিজ্ঞানের হৃদয়।",
          "start_ms": 23194.0,
          "end_ms": 32180.0,
          "duration_ms": 8986.0
        }
      ]
    }
  }
