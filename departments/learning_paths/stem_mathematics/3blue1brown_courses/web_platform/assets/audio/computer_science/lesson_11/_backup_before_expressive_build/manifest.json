      "total_duration_ms": 33974.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "৩. অনুসন্ধানের সমস্যা",
          "start_ms": 0.0,
          "end_ms": 3838.0,
          "duration_ms": 3838.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "ধরা যাক $N$টি আইটেমের মাঝে একটি ''চিহ্নিত'' আইটেম খুঁজতে হবে। ক্লাসিক্যাল কম্পিউটারে গড়ে $N/2$ বার দেখতে হয়—সবচেয়ে খারাপে $N$ বার। কোয়ান্টামে কতটা কমানো যায়?",
          "start_ms": 4188.0,
          "end_ms": 18188.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "অনুসন্ধান—বড় ডাটাবেস থেকে একটি আইটেম",
          "start_ms": 18538.0,
          "end_ms": 23624.0,
          "duration_ms": 5086.0
        },
        {
          "index": 3,
          "type": "chapter-quote",
          "text": "কোয়ান্টাম কম্পিউটার সব কিছু একসাথে ''চেক'' করে না—এটি সঠিক উত্তরের দিকে সম্ভাবনাকে ''ঘুরিয়ে'' আনে।",
          "start_ms": 23974.0,
          "end_ms": 33974.0,
          "duration_ms": 10000.0
        }
      ]
    },
