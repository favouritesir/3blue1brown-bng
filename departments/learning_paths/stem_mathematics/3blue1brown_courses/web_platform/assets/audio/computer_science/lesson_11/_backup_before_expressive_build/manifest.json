    "sec-why": {
      "title": "৫. কোয়ান্টামের সীমা",
      "audio_file": "sec_05_sec-why.mp3",
      "total_duration_ms": 33272.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "৫. কোয়ান্টামের সীমা",
          "start_ms": 0.0,
          "end_ms": 3760.0,
          "duration_ms": 3760.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "গ্রোভার সব সমস্যা ত্বরান্বিত করে না—কেবল ''অনুসন্ধান''-এর মতো কিছু কাঠামোতে কাজ করে। আর $\\sqrt{N}$ একটি ''দ্বিঘাত'' ত্বরণ, শোরের অ্যালগরিদমের মতো ''সূচক'' ত্বরণ নয়।",
          "start_ms": 4110.0,
          "end_ms": 18110.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "বিভিন্ন অ্যালগরিদমের ত্বরণ তুলনা",
          "start_ms": 18460.0,
          "end_ms": 23156.0,
          "duration_ms": 4696.0
        },
        {
          "index": 3,
          "type": "callout",
          "text": "কোয়ান্টাম কম্পিউটার সাধারণ কম্পিউটারের বিকল্প নয়—এটি নির্দিষ্ট কাজের জন্য এক ''নতুন হাতিয়ার''।",
          "start_ms": 23506.0,
          "end_ms": 33272.0,
          "duration_ms": 9766.0
        }
      ]
