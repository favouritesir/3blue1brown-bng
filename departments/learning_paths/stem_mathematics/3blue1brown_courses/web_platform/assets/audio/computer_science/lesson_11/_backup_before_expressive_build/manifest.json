      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "১. কিউবিট কী?",
          "start_ms": 0.0,
          "end_ms": 3214.0,
          "duration_ms": 3214.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "সাধারণ বিট ০ বা ১—যেকোনো একটি। কিউবিট একসাথে ০ ও ১-এর ''সুপারপজিশনে'' থাকতে পারে। একে একটি ভেক্টর দিয়ে লেখা যায়, যার দুটি উপাংশ যথাক্রমে ০ ও ১-এর ''অ্যাম্প্লিচিউড''।",
          "start_ms": 3564.0,
          "end_ms": 17564.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "কিউবিট—ব্লোচ গোলকের ওপর একটি বিন্দু",
          "start_ms": 17914.0,
          "end_ms": 22844.0,
          "duration_ms": 4930.0
        },
        {
          "index": 3,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র।",
          "start_ms": 23194.0,
          "end_ms": 26486.0,
          "duration_ms": 3292.0
        },
        {
          "index": 4,
          "type": "callout",
          "text": "অ্যাম্প্লিচিউডের বর্গই হলো সম্ভাবনা—কিন্তু অ্যাম্প্লিচিউড নিজে ঋণাত্মক হতে পারে, আর এই ''চিহ্ন''-ই কোয়ান্টামের শক্তি।",
          "start_ms": 26836.0,
          "end_ms": 38240.0,
          "duration_ms": 11404.0
        }
      ]
    },
    "sec-state": {
      "title": "২. একাধিক কিউবিট ও স্টেট স্পেস",
      "audio_file": "sec_02_sec-state.mp3",
      "total_duration_ms": 37818.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "২. একাধিক কিউবিট ও স্টেট স্পেস",
          "start_ms": 0.0,
          "end_ms": 4540.0,
          "duration_ms": 4540.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "$n$টি কিউবিট একসাথে $2^n$টি অবস্থার সুপারপজিশনে থাকে। অর্থাৎ ৩০টি কিউবিট প্রায় ১০ কোটি অবস্থা একসাথে ''ধরে''—ক্লাসিক্যাল কম্পিউটারের চেয়ে অনেক বড় স্টেট স্পেস।",
          "start_ms": 4890.0,
          "end_ms": 18890.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "$2^n$ অবস্থার স্টেট ভেক্টর",
          "start_ms": 19240.0,
          "end_ms": 23468.0,
          "duration_ms": 4228.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "কিন্তু এক নজরে সব অবস্থা ''দেখা'' যায় না—পরিমাপ করলেই অবস্থা একটি মাত্র ফলাফলে ''ভেঙে'' পড়ে। তাই কৌশল হলো হস্তক্ষেপ ব্যবহার করে সঠিক উত্তরের সম্ভাবনা বাড়ানো।",
          "start_ms": 23818.0,
          "end_ms": 37818.0,
          "duration_ms": 14000.0
        }
      ]
    },
    "sec-search": {
      "title": "৩. অনুসন্ধানের সমস্যা",
