        {
          "index": 1,
          "type": "p",
          "text": "গ্রোভারের অ্যালগরিদম দুটি ধাপ বারবার করে—(১) ''অরাকেল'' দিয়ে লক্ষ্য অবস্থার চিহ্ন উল্টানো, (২) গড়ের সাপেক্ষে ''প্রতিফলন''। প্রতি বারে লক্ষ্যের অ্যাম্প্লিচিউড বেড়ে যায়।",
          "start_ms": 4344.0,
          "end_ms": 18344.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "figure",
          "text": "গ্রোভারের অ্যাম্প্লিচিউড বৃদ্ধি—ধাপে ধাপে",
          "start_ms": 18694.0,
          "end_ms": 24092.0,
          "duration_ms": 5398.0
        },
        {
          "index": 3,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র।",
