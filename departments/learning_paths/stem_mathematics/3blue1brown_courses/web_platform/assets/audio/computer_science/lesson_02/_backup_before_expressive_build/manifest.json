        {
          "index": 5,
          "type": "chapter-quote",
          "text": "ক্রস-এন্ট্রপি সবসময় নিজের এন্ট্রপির চেয়ে বড় বা সমান—ভুলের মূল্য সবসময়ই দিতে হয়।",
          "start_ms": 41866.0,
          "end_ms": 50618.0,
          "duration_ms": 8752.0
        }
      ]
    },
