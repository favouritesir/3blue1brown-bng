          "end_ms": 18422.0,
          "duration_ms": 14000.0
        },
        {
          "index": 2,
          "type": "formula-box",
          "text": "গাণিতিক সূত্র।",
          "start_ms": 18772.0,
          "end_ms": 22064.0,
          "duration_ms": 3292.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "এটিকে বলা হয় ক্রস-এন্ট্রপি। মনে রাখবেন—এন্ট্রপি $H(p)$ হলো নিখুঁত মডেলের সর্বনিম্ন খরচ; ক্রস-এন্ট্রপি হলো আমাদের মডেলের প্রকৃত খরচ।",
          "start_ms": 22414.0,
          "end_ms": 34910.0,
          "duration_ms": 12496.0
        },
        {
          "index": 4,
          "type": "figure",
          "text": "ক্রস-এন্ট্রপি = সত্য বন্টনে মডেলের কোডের গড় দৈর্ঘ্য",
          "start_ms": 35260.0,
