        {
          "index": 3,
          "type": "callout",
          "text": "ভুল মডেলের কারণে যে বাড়তি বিট খরচ হয়, তা কত? এর সুষ্ঠু পরিমাপই পরবর্তী ধাপ।",
          "start_ms": 25300.0,
          "end_ms": 33506.0,
          "duration_ms": 8206.0
