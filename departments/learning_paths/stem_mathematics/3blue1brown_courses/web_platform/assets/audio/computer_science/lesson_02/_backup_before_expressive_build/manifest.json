        {
          "index": 5,
          "type": "callout",
          "text": "ক্রস-এন্ট্রপি = এন্ট্রপি + কেএল ডাইভারজেন্স। এই সরল সমীকরণটি পুরো মেশিন লার্নিংয়ের ভিত্তি।",
          "start_ms": 38490.0,
