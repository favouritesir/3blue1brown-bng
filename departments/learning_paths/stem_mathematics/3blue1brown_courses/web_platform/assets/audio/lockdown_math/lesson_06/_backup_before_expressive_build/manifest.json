  "sections": {
    "sec-discrete-to-continuous": {
      "title": "বিচ্ছিন্ন স্তম্ভ থেকে অবিচ্ছিন্ন তরঙ্গে উত্তরণ",
      "audio_file": "sec-discrete-to-continuous.mp3",
      "total_duration_ms": 31308.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "বিচ্ছিন্ন স্তম্ভ থেকে অবিচ্ছিন্ন তরঙ্গে উত্তরণ",
          "start_ms": 0.0,
          "end_ms": 3744.0,
          "duration_ms": 3744.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "বাস্তব জগতের বহু চলক বিচ্ছিন্ন ধাপে নয়, অবিচ্ছিন্ন রেখায় বিস্তৃত থাকে।",
          "start_ms": 4094.0,
          "end_ms": 9326.0,
          "duration_ms": 5232.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "হিস্টোগ্রামের বারগুলোর প্রস্থ শূন্যের কাছাকাছি নিলে তা মসৃণ বক্ররেখায় পরিণত হয়।",
          "start_ms": 9676.0,
          "end_ms": 15220.0,
          "duration_ms": 5544.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "সমষ্টি রূপ নেয় সমাকলনে: \\sum \\to \\int।",
          "start_ms": 15570.0,
          "end_ms": 18858.0,
          "duration_ms": 3288.0
        },
        {
          "index": 4,
          "type": "formula-box",
          "text": "বিচ্ছিন্ন সম্ভাবনার সমষ্টি: \\sum_{i} P(X = x_i) = 1.0",
          "start_ms": 19208.0,
          "end_ms": 24392.0,
          "duration_ms": 5184.0
        },
        {
          "index": 5,
          "type": "formula-box",
          "text": "অবিচ্ছিন্ন স্বাভাবিকীকরণ শর্ত: \\int_{ \\infty}^{\\infty} f(x)\\,dx = 1.0",
          "start_ms": 24742.0,
          "end_ms": 30958.0,
          "duration_ms": 6216.0
        }
      ]
    },
    "sec-zero-prob-paradox": {
      "title": "একক বিন্দুর শূন্য সম্ভাব্যতা প্যারাডক্স",
      "audio_file": "sec-zero-prob-paradox.mp3",
      "total_duration_ms": 29916.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "একক বিন্দুর শূন্য সম্ভাব্যতা প্যারাডক্স",
          "start_ms": 0.0,
          "end_ms": 3288.0,
          "duration_ms": 3288.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "অবিচ্ছিন্ন চলকে একক বিন্দুর সম্ভাবনা সর্বদা শূন্য: P(X=c) = 0।",
          "start_ms": 3638.0,
          "end_ms": 8870.0,
          "duration_ms": 5232.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "সম্ভাবনা শূন্য হলেও ঘটনাটি বাস্তবে ঘটা সম্পূর্ণ সম্ভব।",
          "start_ms": 9220.0,
          "end_ms": 13588.0,
          "duration_ms": 4368.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "সম্ভাবনা কেবল একটি ধনাত্মক দৈর্ঘ্যের ব্যবধানেই ক্ষেত্রফল ধারণ করে।",
          "start_ms": 13938.0,
          "end_ms": 18642.0,
          "duration_ms": 4704.0
        },
        {
          "index": 4,
          "type": "formula-box",
          "text": "একক বিন্দুর সম্ভাব্যতা উপপাদ্য: P(X = c) = 0 \\quad (\\forall c \\in \\mathbb{R})",
          "start_ms": 18992.0,
          "end_ms": 24872.0,
          "duration_ms": 5880.0
        },
        {
          "index": 5,
          "type": "formula-box",
          "text": "প্রান্তবিন্দুর স্বাধীনতা: P(a \\le X \\le b) = P(a < X < b)",
          "start_ms": 25222.0,
          "end_ms": 29566.0,
          "duration_ms": 4344.0
        }
      ]
    },
    "sec-density-concept": {
      "title": "সম্ভাব্যতা ঘনত্ব f(x): উচ্চতা বনাম ক্ষেত্রফল",
      "audio_file": "sec-density-concept.mp3",
      "total_duration_ms": 34356.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "সম্ভাব্যতা ঘনত্ব f(x): উচ্চতা বনাম ক্ষেত্রফল",
          "start_ms": 0.0,
          "end_ms": 3984.0,
          "duration_ms": 3984.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "f(x) হলো সম্ভাব্যতা ঘনত্ব, সরাসরি সম্ভাব্যতা নয়।",
          "start_ms": 4334.0,
          "end_ms": 8726.0,
          "duration_ms": 4392.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "সম্ভাব্যতা হলো বক্ররেখার নিচের নির্দিষ্ট এলাকার ক্ষেত্রফল।",
          "start_ms": 9076.0,
          "end_ms": 13396.0,
          "duration_ms": 4320.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "ক্ষুদ্র অঞ্চলে ঘনত্ব অনেক বেশি (এমনকি ১ এর চেয়েও বেশি) হতে পারে।",
          "start_ms": 13746.0,
          "end_ms": 18738.0,
          "duration_ms": 4992.0
        },
        {
          "index": 4,
          "type": "formula-box",
          "text": "ব্যবধানে সম্ভাব্যতা নির্ণয়: P(a \\le X \\le b) = \\int_a^b f(x)\\,dx",
          "start_ms": 19088.0,
          "end_ms": 24440.0,
          "duration_ms": 5352.0
        },
        {
          "index": 5,
          "type": "formula-box",
          "text": "ঘনত্ব ফাংশনের দুই মৌলিক শর্ত: f(x) \\ge 0 \\quad (\\forall x), \\qquad \\int_{ \\infty}^{\\infty} f(x)\\,dx = 1.0",
          "start_ms": 24790.0,
          "end_ms": 34006.0,
          "duration_ms": 9216.0
        }
      ]
    },
    "sec-uniform-exponential": {
      "title": "বাস্তব মডেল: সুষম বণ্টন ও এক্সপোনেনশিয়াল স্মৃতিহীনতা",
      "audio_file": "sec-uniform-exponential.mp3",
      "total_duration_ms": 33396.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "বাস্তব মডেল: সুষম বণ্টন ও এক্সপোনেনশিয়াল স্মৃতিহীনতা",
          "start_ms": 0.0,
          "end_ms": 4512.0,
          "duration_ms": 4512.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "সুষম বণ্টনে সম্ভাব্যতা কেবল ব্যবধানের দৈর্ঘ্যের সমানুপাতিক হয়।",
          "start_ms": 4862.0,
          "end_ms": 9566.0,
          "duration_ms": 4704.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "এক্সপোনেনশিয়াল বণ্টন সময় ও অপেক্ষার প্রক্রিয়াকে সূচকীয়ভাবে মডেল করে।",
          "start_ms": 9916.0,
          "end_ms": 15052.0,
          "duration_ms": 5136.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "স্মৃতিহীনতা অবিচ্ছিন্ন এক্সপোনেনশিয়াল প্রক্রিয়ার অনন্য গাণিতিক পরিচয়।",
          "start_ms": 15402.0,
          "end_ms": 20346.0,
          "duration_ms": 4944.0
        },
        {
          "index": 4,
          "type": "formula-box",
          "text": "সুষম বণ্টনের ঘনত্ব: f(x) = \\frac{1}{b a} \\quad (a \\le x \\le b)",
          "start_ms": 20696.0,
          "end_ms": 26384.0,
          "duration_ms": 5688.0
        },
        {
          "index": 5,
          "type": "formula-box",
          "text": "এক্সপোনেনশিয়াল বণ্টন: f(x) = \\lambda e^{ \\lambda x}, \\qquad P(X > t) = e^{ \\lambda t}",
          "start_ms": 26734.0,
          "end_ms": 33046.0,
          "duration_ms": 6312.0
        }
      ]
    },
    "sec-cdf-calculus": {
      "title": "ক্রমযোজিত সম্ভাবনা (CDF) ও ক্যালকুলাসের মৌলিক উপপাদ্য",
      "audio_file": "sec-cdf-calculus.mp3",
      "total_duration_ms": 37308.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "ক্রমযোজিত সম্ভাবনা (CDF) ও ক্যালকুলাসের মৌলিক উপপাদ্য",
          "start_ms": 0.0,
          "end_ms": 4608.0,
          "duration_ms": 4608.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "CDF হলো বাম দিক থেকে সঞ্চিত মোট ক্ষেত্রফল F(x) = P(X \\le x)।",
          "start_ms": 4958.0,
          "end_ms": 9854.0,
          "duration_ms": 4896.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "CDF এর পরিবর্তনের হার (ঢাল) সরাসরি পিডিএফ এর উচ্চতা f(x) প্রদান করে।",
          "start_ms": 10204.0,
          "end_ms": 16084.0,
          "duration_ms": 5880.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "যেকোনো ব্যবধানের সম্ভাবনা সরাসরি F(b) F(a) দিয়ে এক নিমিষে বের করা যায়।",
          "start_ms": 16434.0,
          "end_ms": 21954.0,
          "duration_ms": 5520.0
        },
        {
          "index": 4,
          "type": "formula-box",
          "text": "ক্রমযোজিত সম্ভাবনা ফাংশন (CDF): F(x) = P(X \\le x) = \\int_{ \\infty}^x f(t)\\,dt",
          "start_ms": 22304.0,
          "end_ms": 28880.0,
          "duration_ms": 6576.0
        },
        {
          "index": 5,
          "type": "formula-box",
          "text": "ক্যালকুলাসের মৌলিক সংযোগ: \\frac{d}{dx}F(x) = f(x), \\qquad P(a \\le X \\le b) = F(b) F(a)",
          "start_ms": 29230.0,
          "end_ms": 36958.0,
          "duration_ms": 7728.0
        }
      ]
    },
    "sec-clt-emergence": {
      "title": "সেন্ট্রাল লিমিট থিওরেম: গ্যালটন বোর্ড ও বেল কার্ভ",
      "audio_file": "sec-clt-emergence.mp3",
      "total_duration_ms": 43260.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "সেন্ট্রাল লিমিট থিওরেম: গ্যালটন বোর্ড ও বেল কার্ভ",
          "start_ms": 0.0,
          "end_ms": 3888.0,
          "duration_ms": 3888.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "বহু স্বাধীন দৈব চলকের সমষ্টি সর্বদা একটি নরমাল বেল কার্ভে পরিণত হয়।",
          "start_ms": 4238.0,
          "end_ms": 9446.0,
          "duration_ms": 5208.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "আদি চলকগুলোর নিজস্ব আকৃতি যাই হোক না কেন, সিএলটি সবার ওপর সমভাবে কার্যকর।",
          "start_ms": 9796.0,
          "end_ms": 15580.0,
          "duration_ms": 5784.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "প্রকৃতির অসংখ্য পরিমাপ ও ভৌত অস্থিরতার পেছনে রয়েছে এই গাউসিয়ান ঐকতান।",
          "start_ms": 15930.0,
          "end_ms": 21258.0,
          "duration_ms": 5328.0
        },
        {
          "index": 4,
          "type": "formula-box",
          "text": "নরমাল ডিস্ট্রিবিউশন ঘনত্ব: f(x) = \\frac{1}{\\sigma \\sqrt{2\\pi}} e^{ \\frac{1}{2}\\left(\\frac{x \\mu}{\\sigma}\\right)^2}",
          "start_ms": 21608.0,
          "end_ms": 31952.0,
          "duration_ms": 10344.0
        },
        {
          "index": 5,
          "type": "formula-box",
          "text": "সেন্ট্রাল লিমিট থিওরেমের সীমাস্থ রূপ: Z = \\frac{\\bar{X}_n \\mu}{\\sigma / \\sqrt{n}} \\xrightarrow{d} \\mathcal{N}(0, 1) \\quad (n \\to \\infty)",
          "start_ms": 32302.0,
          "end_ms": 42910.0,
          "duration_ms": 10608.0
        }
      ]
    },
