[
  {
    "index": 0,
    "type": "h2",
    "text": "অয়লারের অভেদ: পাঁচটি মৌলিক ধ্রুবকের একীভূত রূপ",
    "start_ms": 0.0,
    "end_ms": 3912.0,
    "duration_ms": 3912.0
  },
  {
    "index": 1,
    "type": "p",
    "text": "θ = π বসালে কণাটি জটিল সমতলে ঠিক ১৮০° ঘুরে বাস্তব অক্ষের ১ এ উপনীত হয়।",
    "start_ms": 4262.0,
    "end_ms": 9686.0,
    "duration_ms": 5424.0
  },
  {
    "index": 2,
    "type": "p",
    "text": "e^{iπ} = 1 হলো বৃত্তীয় ঘূর্ণন ও সূচকীয় ফাংশনের নিখুঁত মিলন।",
    "start_ms": 10036.0,
    "end_ms": 14740.0,
    "duration_ms": 4704.0
  },
  {
    "index": 3,
    "type": "p",
    "text": "e, i, π, 1, এবং 0 এর মেলবন্ধন গণিতের অনন্য ঐক্যের স্মারক।",
    "start_ms": 15090.0,
    "end_ms": 20034.0,
    "duration_ms": 4944.0
  },
  {
    "index": 4,
    "type": "formula-box",
    "text": "অয়লারের অভেদ: e^{i\\pi} + 1 = 0",
    "start_ms": 20384.0,
    "end_ms": 23672.0,
    "duration_ms": 3288.0
  },
  {
    "index": 5,
    "type": "formula-box",
    "text": "অর্ধ ঘূর্ণন জ্যামিতি: e^{i\\pi} = 1, \\qquad e^{i 2\\pi} = 1",
    "start_ms": 24022.0,
    "end_ms": 29086.0,
