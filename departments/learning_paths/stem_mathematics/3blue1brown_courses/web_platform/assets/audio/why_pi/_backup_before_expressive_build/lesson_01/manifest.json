  "sections": {
    "sec-setup": {
      "title": "ধাঁধাটির সেটআপ",
      "audio_file": "sec_01_sec-setup.mp3",
      "total_duration_ms": 20000.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "দুটি ব্লক, একটি দেয়াল, ঘর্ষণহীন পৃষ্ঠ এবং সম্পূর্ণ স্থিতিস্থাপক সংঘর্ষ— এই আদর্শ পরিস্থিতিতেও ফলাফল কী হবে তা এক নজরে বোঝা যায় না।",
          "start_ms": 0.0,
          "end_ms": 4500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "বড় ব্লকটি ডান থেকে একটি নির্দিষ্ট বেগে আসে, ছোট ব্লকটি প্রথমে স্থির থাকে এবং বাঁ দিকে একটি দেয়াল থাকে।",
          "start_ms": 5000.0,
          "end_ms": 9500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "ঘর্ষণ নেই এবং প্রতিটি সংঘর্ষ সম্পূর্ণ স্থিতিস্থাপক—অর্থাৎ শক্তির কোনো ক্ষতি হয় না।",
          "start_ms": 10000.0,
          "end_ms": 14500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "দুটি ব্লকের ভর সমান হলে মোট তিনবার সংঘর্ষ হয়: একবার ব্লকদ্বয়ের মধ্যে, একবার দেয়ালে, আবার একবার ব্লকদ্বয়ের মধ্যে।",
          "start_ms": 15000.0,
          "end_ms": 19500.0,
          "duration_ms": 4500.0
        }
      ]
    },
    "sec-pattern": {
      "title": "অঙ্কগুলোর অপ্রত্যাশিত প্যাটার্ন",
      "audio_file": "sec_02_sec-pattern.mp3",
      "total_duration_ms": 20000.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "ভরের অনুপাত ১০০-এর ঘাত হলে সংঘর্ষের সংখ্যা পাইয়ের প্রথম অঙ্কগুলোর সাথে মেলে—একটি সম্পূর্ণ অবিশ্বাস্য আবিষ্কার।",
          "start_ms": 0.0,
          "end_ms": 4500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "ভর অনুপাত ১০০ : ১ হলে ৩১টি সংঘর্ষ; ১০,০০০ : ১ হলে ৩১৪টি; ১০,০০,০০০ : ১ হলে ৩,১৪১টি।",
          "start_ms": 5000.0,
          "end_ms": 9500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "এই সংখ্যাগুলো π ≈ 3.14159… এর প্রথম অঙ্কগুলোর ঠিক মতোই।",
          "start_ms": 10000.0,
          "end_ms": 14500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "Gregory Galperin ১৯৯৫ সালে এই ঘটনাটি আবিষ্কার করেন এবং ২০০৩ সালে প্রকাশ করেন।",
          "start_ms": 15000.0,
          "end_ms": 19500.0,
          "duration_ms": 4500.0
        }
      ]
    },
    "sec-hidden-circle": {
      "title": "লুকোনো বৃত্ত ও শক্তির সংরক্ষণ",
      "audio_file": "sec_03_sec-hidden-circle.mp3",
      "total_duration_ms": 20000.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "যেখানে পাই আছে সেখানে একটা বৃত্ত আছে—এই ক্ষেত্রে বৃত্তটা আসে শক্তির সংরক্ষণ সূত্র থেকে।",
          "start_ms": 0.0,
          "end_ms": 4500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "দুই ব্লকের মোট গতিশক্তি সংঘর্ষের আগে ও পরে একই থাকে।",
          "start_ms": 5000.0,
          "end_ms": 9500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "√m₁·v₁ ও √m₂·v₂ কে অক্ষ হিসেবে নিলে শক্তির সমীকরণটা becomes একটা বৃত্ত— $x^2+y^2=\\text{const}$।",
          "start_ms": 10000.0,
          "end_ms": 14500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "ভরবেগের সংরক্ষণ এই বৃত্তে সরলরেখা দ্বারা কাটা বিন্দুগুলোর মাঝে চলাচল নির্ধারণ করে।",
          "start_ms": 15000.0,
          "end_ms": 19500.0,
          "duration_ms": 4500.0
        }
      ]
    }
  }
