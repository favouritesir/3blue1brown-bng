{
  "course": "why_pi",
  "lesson": "lesson_03",
  "voice": "bn-BD-PradeepNeural",
  "mode": "authentic_teacher",
  "sections": {
    "sec-position-space": {
      "title": "অবস্থান-ফেজ স্পেস",
      "audio_file": "sec_01_sec-position-space.mp3",
      "total_duration_ms": 20000.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "এবার অক্ষগুলো বেগ নয়, ব্লকদুটির অবস্থান বোঝাবে। দুটি ব্লকের দূরত্বই একটা বিন্দুর অবস্থান নির্ধারণ করে।",
          "start_ms": 0.0,
          "end_ms": 4500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "x-অক্ষ দেয়াল থেকে বড় ব্লকের বাঁ প্রান্তের দূরত্ব $d_1$, y-অক্ষ ছোট ব্লকের ডান প্রান্তের দূরত্ব $d_2$।",
          "start_ms": 5000.0,
          "end_ms": 9500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "$x=y$ রেখায় ব্লকদুটি সংঘর্ষ করে; নিচের সীমানায় ছোট ব্লক দেয়ালে ঠুকে।",
          "start_ms": 10000.0,
          "end_ms": 14500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "আগের পাঠের মতোই এখানে也是在 একটা বিন্দু সিস্টেমের পুরো অবস্থা প্রকাশ করে।",
          "start_ms": 15000.0,
          "end_ms": 19500.0,
          "duration_ms": 4500.0
        }
      ]
    },
    "sec-rescale": {
      "title": "ভর দিয়ে অক্ষ স্কেল করা",
      "audio_file": "sec_02_sec-rescale.mp3",
      "total_duration_ms": 20000.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "√m দিয়ে অক্ষ স্কেল করলে শক্তি হয় “আলোর ধ্রুবক বেগ” আর ভরবেগ হয় “আপতন কোণ = প্রতিফলন কোণ”—অপটিক্যাল অ্যানালজিটি সঠিক হয়ে যায়।",
          "start_ms": 0.0,
          "end_ms": 4500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "নতুন অক্ষ: $x=\\sqrt{m_1}d_1$, $y=\\sqrt{m_2}d_2$।",
          "start_ms": 5000.0,
          "end_ms": 9500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "বিন্দুর বেগের মান $\\sqrt{2E}$—যা ধ্রুবক, ঠিক যেন আলোর বেগ ধ্রুবক।",
          "start_ms": 10000.0,
          "end_ms": 14500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "ভরবেগের সংরক্ষণ নিশ্চিত করে আপতন কোণ = প্রতিফলন কোণ, অর্থাৎ সীমানাগুলো আসলেই আয়নার মতো কাজ করে।",
          "start_ms": 15000.0,
          "end_ms": 19500.0,
          "duration_ms": 4500.0
        }
      ]
    },
    "sec-unfold": {
      "title": "আয়না “খুলে” সোজা রশ্মি",
      "audio_file": "sec_03_sec-unfold.mp3",
      "total_duration_ms": 20000.0,
      "cues": [
        {
          "index": 0,
          "type": "h2",
          "text": "রশ্মিকে প্রতিফলিত হতে না দিয়ে বরং পুরো বিশ্বকে উল্টিয়ে দিলে রশ্মিটা সোজা চলে—তখন সংঘর্ষ গণনা হয়ে যায় কাঁচের টুকরো গণনা।",
          "start_ms": 0.0,
          "end_ms": 4500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 1,
          "type": "p",
          "text": "প্রতিফলনের বদলে বিশ্বকে উল্টানো: রশ্মি সোজা যায়, আর আমরা “লুকিং-গ্লাস” ইউনিভার্সে প্রবেশ করি।",
          "start_ms": 5000.0,
          "end_ms": 9500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 2,
          "type": "p",
          "text": "আয়নাদুটোর মাঝের কোণ θ হলে কতবার θ যোগ করা যায় যাতে যোগফল π-র কম থাকে—সেটাই উত্তর।",
          "start_ms": 10000.0,
          "end_ms": 14500.0,
          "duration_ms": 4500.0
        },
        {
          "index": 3,
          "type": "p",
          "text": "সংখ্যা $\\left\\lfloor \\pi/\\theta \\right\\rfloor$ (সঠিক ক্ষেত্রে $\\lceil \\pi/\\theta\\rceil-1$)।",
          "start_ms": 15000.0,
          "end_ms": 19500.0,
          "duration_ms": 4500.0
        }
      ]
    }
  }
}