  "sections": {
    "sec-intro": {
      "title": "কেন আরেকটি মাত্রা?",
      "audio_file": "sec_01_sec-intro.mp3",
      "total_duration_ms": 46695.0,
      "cues": [
        {
          "type": "h2",
          "text": "প্রথম পরিচ্ছেদ, কেন আরেকটি মাত্রা?।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5425.0,
          "duration_ms": 5425.0
        },
        {
          "type": "p",
          "text": "কখনো কোনো সমস্যা সমতলে অসম্ভব মনে হয়, কিন্তু ত্রিমাত্রিক স্থানে উঠে গেলেই সহজ হয়ে যায়। “বাক্সের বাইরে ভাবা” মানেই প্রায়ই এক পা উঠে নতুন মাত্রায় দেখা।",
          "index": 1,
          "start_ms": 5775.0,
          "end_ms": 17745.0,
          "duration_ms": 11970.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, একটি সমতল ছায়া তার ত্রিমাত্রিক বস্তু সম্পর্কে ইঙ্গিত দেয়",
          "index": 2,
          "start_ms": 18095.0,
          "end_ms": 25885.0,
          "duration_ms": 7790.0
        },
        {
          "type": "p",
          "text": "এই পাঠে পাঁচটি ছোট ধাঁধা দেখব — প্রতিটিতেই মূল পদক্ষেপ হলো প্রশ্নটিকে আরও বড় স্থানে স্থানান্তর করা।",
          "index": 3,
          "start_ms": 26235.0,
          "end_ms": 35235.0,
          "duration_ms": 9000.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: মানসিক চিত্র। ২D-তে যেটি “অতিক্রম করা যায় না”, ৩D-তে সেটি “উপর দিয়ে যাওয়া”। নিষেধাজ্ঞা প্রায়ই মাত্রার উপর নির্ভর করে।",
          "index": 4,
          "start_ms": 35585.0,
          "end_ms": 46345.0,
          "duration_ms": 10760.0
        }
      ]
    },
    "sec-shadow": {
      "title": "ছায়া থেকে বস্তু",
      "audio_file": "sec_02_sec-shadow.mp3",
      "total_duration_ms": 33605.0,
      "cues": [
        {
          "type": "h2",
          "text": "দ্বিতীয় পরিচ্ছেদ, ছায়া থেকে বস্তু।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5480.0,
          "duration_ms": 5480.0
        },
        {
          "type": "p",
          "text": "একটি ত্রিমাত্রিক বস্তুর ছায়া দেখে তার আসল আকার বোঝা কঠিন — কিন্তু বিভিন্ন দিক থেকে একাধিক ছায়া নিলে তথ্য যোগ হয়।",
          "index": 1,
          "start_ms": 5830.0,
          "end_ms": 15655.0,
          "duration_ms": 9825.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, একই বস্তুর বিভিন্ন কোণ থেকে নেওয়া ছায়া",
          "index": 2,
          "start_ms": 16005.0,
          "end_ms": 22805.0,
          "duration_ms": 6800.0
        },
        {
          "type": "p",
          "text": "উচ্চ মাত্রার বস্তুকে নিচ মাত্রায় প্রক্ষেপণ করলে তথ্য হারায়; কিন্তু সেই প্রক্ষেপণগুলো একসাথে আসল গঠন সম্পর্কে বলে দেয়।",
          "index": 3,
          "start_ms": 23155.0,
          "end_ms": 33255.0,
          "duration_ms": 10100.0
        }
      ]
    },
    "sec-knot": {
      "title": "গিঁট ও খোলা লুপ",
      "audio_file": "sec_03_sec-knot.mp3",
      "total_duration_ms": 37565.0,
      "cues": [
        {
          "type": "h2",
          "text": "তৃতীয় পরিচ্ছেদ, গিঁট ও খোলা লুপ।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5315.0,
          "duration_ms": 5315.0
        },
        {
          "type": "p",
          "text": "সমতলে একটি বন্ধ লুপ ভেতরে থাকা বিন্দুকে বাইরে আনতে পারে না — কিন্তু ত্রিমাত্রিকে লুপটিকে উপরে তুলে সহজেই পাশ কাটানো যায়।",
          "index": 1,
          "start_ms": 5665.0,
          "end_ms": 15820.0,
          "duration_ms": 10155.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, সমতলে আবদ্ধ লুপ; ত্রিমাত্রিকে সহজ মুক্তি",
          "index": 2,
          "start_ms": 16170.0,
          "end_ms": 22970.0,
          "duration_ms": 6800.0
        },
        {
          "type": "h3",
          "text": "জটিলতা কমে যায়",
          "index": 3,
          "start_ms": 23320.0,
          "end_ms": 27645.0,
          "duration_ms": 4325.0
        },
        {
          "type": "p",
          "text": "অনেক টপোলজিকাল প্রশ্ন ঠিক এভাবেই সমাধান হয় — কোনো বস্তুকে নিজের মাত্রার চেয়ে বেশি মাত্রায় রেখে দেখলে।",
          "index": 4,
          "start_ms": 27995.0,
          "end_ms": 37215.0,
          "duration_ms": 9220.0
        }
      ]
    },
    "sec-encoding": {
      "title": "তথ্য ও মাত্রা",
      "audio_file": "sec_04_sec-encoding.mp3",
      "total_duration_ms": 34705.0,
      "cues": [
        {
          "type": "h2",
          "text": "চতুর্থ পরিচ্ছেদ, তথ্য ও মাত্রা।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5205.0,
          "duration_ms": 5205.0
        },
        {
          "type": "p",
          "text": "আরেকটি ধাঁধা: কম জায়গায় বেশি তথ্য রাখা। এক মাত্রায় সীমাবদ্ধ থাকলে যা অসম্ভব, দুই মাত্রায় তা সহজ — যেমন একটি সংখ্যার বিটগুলোকে বর্গাকার গ্রিডে সাজানো।",
          "index": 1,
          "start_ms": 5555.0,
          "end_ms": 17470.0,
          "duration_ms": 11915.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, এক মাত্রার তথ্য দ্বিমাত্রিক গ্রিডে সাজানো",
          "index": 2,
          "start_ms": 17820.0,
          "end_ms": 24675.0,
          "duration_ms": 6855.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: পরবর্তী পাঠ। দাবার বোর্ড ধাঁধায় ঠিক এই ধারণা ব্যবহার করা হবে — ৬৪টি বর্গে ৬ বিটের তথ্য লুকানো।",
          "index": 3,
          "start_ms": 25025.0,
          "end_ms": 34355.0,
          "duration_ms": 9330.0
        }
      ]
    },
    "sec-takeaway": {
      "title": "শিক্ষণীয় বিষয়",
      "audio_file": "sec_05_sec-takeaway.mp3",
      "total_duration_ms": 23705.0,
      "cues": [
        {
          "type": "h2",
          "text": "পঞ্চম পরিচ্ছেদ, শিক্ষণীয় বিষয়।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5260.0,
          "duration_ms": 5260.0
        },
        {
          "type": "p",
          "text": "ধাঁধা সমাধানের জন্য প্রয়োজনীয় উপকরণ প্রায়ই সমস্যার ভেতরেই থাকে; আমরা কেবল সেগুলোকে নতুন কোণ থেকে দেখি না।",
          "index": 1,
          "start_ms": 5610.0,
          "end_ms": 15050.0,
          "duration_ms": 9440.0
        },
        {
          "type": "p",
          "text": "“অসম্ভব” মানে অনেক সময় “এই মাত্রায় অসম্ভব” — সীমাটি আমাদের চিন্তার, বস্তুর নয়।",
          "index": 2,
          "start_ms": 15400.0,
          "end_ms": 23355.0,
          "duration_ms": 7955.0
        }
      ]
    }
  }
}