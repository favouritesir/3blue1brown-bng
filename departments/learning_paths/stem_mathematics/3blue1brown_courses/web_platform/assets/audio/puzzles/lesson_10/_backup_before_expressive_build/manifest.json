  "sections": {
    "sec-formula": {
      "title": "সূত্রটি",
      "audio_file": "sec_01_sec-formula.mp3",
      "total_duration_ms": 47245.0,
      "cues": [
        {
          "type": "h2",
          "text": "প্রথম পরিচ্ছেদ, সূত্রটি।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 4820.0,
          "duration_ms": 4820.0
        },
        {
          "type": "p",
          "text": "যেকোনো সংযুক্ত সমতলিক গ্রাফের শীর্ষ (V), ধার (E) ও ফলক (F) হলে সবসময় V − E + F = 2। বাইরের অঞ্চলটিকেও একটি ফলক হিসেবে গণনা করা হয়।",
          "index": 1,
          "start_ms": 5170.0,
          "end_ms": 15930.0,
          "duration_ms": 10760.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, একটি সমতলিক গ্রাফ — শীর্ষ, ধার ও ফলক",
          "index": 2,
          "start_ms": 16280.0,
          "end_ms": 22860.0,
          "duration_ms": 6580.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: V-E+F=2",
          "index": 3,
          "start_ms": 23210.0,
          "end_ms": 27920.0,
          "duration_ms": 4710.0
        },
        {
          "type": "p",
          "text": "উদাহরণ: একটি ত্রিভুজ — V = 3, E = 3, F = 2 (ভেতর + বাইর)। ৩ − ৩ + ২ = ২।",
          "index": 4,
          "start_ms": 28270.0,
          "end_ms": 35730.0,
          "duration_ms": 7460.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: অয়লারের মহান দৃষ্টি। ১৭৫০-এর দশকে অয়লার লক্ষ করেন পলিহেড্রনের ক্ষেত্রেও একই সম্পর্ক ধরে — এটি টপোলজির জন্মের অন্যতম ধাপ।",
          "index": 5,
          "start_ms": 36080.0,
          "end_ms": 46895.0,
          "duration_ms": 10815.0
        }
      ]
    },
    "sec-tree": {
      "title": "স্প্যানিং ট্রি",
      "audio_file": "sec_02_sec-tree.mp3",
      "total_duration_ms": 42240.0,
      "cues": [
        {
          "type": "h2",
          "text": "দ্বিতীয় পরিচ্ছেদ, স্প্যানিং ট্রি।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5370.0,
          "duration_ms": 5370.0
        },
        {
          "type": "p",
          "text": "প্রমাণের প্রথম ধাপ: গ্রাফের একটি স্প্যানিং ট্রি বাছুন — সব শীর্ষকে যুক্ত করে এমন উপগ্রাফ যাতে কোনো চক্র নেই। একটি V-শীর্ষের ট্রিতে E = V − 1 টি ধার থাকে।",
          "index": 1,
          "start_ms": 5720.0,
          "end_ms": 17635.0,
          "duration_ms": 11915.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, চক্র বাদ দিয়ে গ্রাফের মেরুদণ্ড",
          "index": 2,
          "start_ms": 17985.0,
          "end_ms": 24290.0,
          "duration_ms": 6305.0
        },
        {
          "type": "p",
          "text": "ট্রির কোনো চক্র নেই, তাই একটিমাত্র ফলক — বাইরের অঞ্চল। তখন V − E + F = V − (V−1) + 1 = ২। সূত্রটি ট্রির ক্ষেত্রে প্রমাণিত।",
          "index": 3,
          "start_ms": 24640.0,
          "end_ms": 34850.0,
          "duration_ms": 10210.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: E_{\\text{tree}}=V-1,\\quad F_{\\text{tree}}=1",
          "index": 4,
          "start_ms": 35200.0,
          "end_ms": 41890.0,
          "duration_ms": 6690.0
        }
      ]
    },
    "sec-dual": {
      "title": "ডুয়াল গ্রাফ",
      "audio_file": "sec_03_sec-dual.mp3",
      "total_duration_ms": 46255.0,
      "cues": [
        {
          "type": "h2",
          "text": "তৃতীয় পরিচ্ছেদ, ডুয়াল গ্রাফ।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5150.0,
          "duration_ms": 5150.0
        },
        {
          "type": "p",
          "text": "এখন বাদ পড়া ধারগুলো ফিরিয়ে আনুন। প্রতিটি বাদ-দেওয়া ধার একটি নতুন চক্র তৈরি করে এবং ফলককে দুই ভাগে ভাগ করে — অর্থাৎ E বাড়ে ১, F-ও বাড়ে ১।",
          "index": 1,
          "start_ms": 5500.0,
          "end_ms": 16755.0,
          "duration_ms": 11255.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, ফলককে বিন্দু বানিয়ে তৈরি ডুয়াল গ্রাফ",
          "index": 2,
          "start_ms": 17105.0,
          "end_ms": 23795.0,
          "duration_ms": 6690.0
        },
        {
          "type": "p",
          "text": "প্রতিটি ধার ফেরত দিলে V − E + F-এর মান অপরিবর্তিত থাকে (−১ + ১ = ০)। অতএব শেষ পর্যন্ত মান ২-ই থাকে — সম্পূর্ণ প্রমাণ।",
          "index": 3,
          "start_ms": 24145.0,
          "end_ms": 34080.0,
          "duration_ms": 9935.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: ডুয়ালিটি। ফলকগুলোকে বিন্দু বানিয়ে ও ধারগুলোকে প্রথিক্রম করে যে গ্রাফ পাই, তাকে ডুয়াল গ্রাফ বলে। মূল ও ডুয়ালের ভূমিকা বিনিময়যোগ্য।",
          "index": 4,
          "start_ms": 34430.0,
          "end_ms": 45905.0,
          "duration_ms": 11475.0
        }
      ]
    },
    "sec-generalize": {
      "title": "অন্য পৃষ্ঠে",
      "audio_file": "sec_04_sec-generalize.mp3",
      "total_duration_ms": 37180.0,
      "cues": [
        {
          "type": "h2",
          "text": "চতুর্থ পরিচ্ছেদ, অন্য পৃষ্ঠে।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5095.0,
          "duration_ms": 5095.0
        },
        {
          "type": "p",
          "text": "গোলকের ক্ষেত্রেও V − E + F = 2 (টোরাসে 0)। সাধারণভাবে এই মানকে বলা হয় অয়লার বৈশিষ্ট্য χ — এটি পৃষ্ঠের গঠনগত পরিচয়।",
          "index": 1,
          "start_ms": 5445.0,
          "end_ms": 15380.0,
          "duration_ms": 9935.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, গোলকপৃষ্ঠে অঙ্কিত গ্রাফ — একই সূত্র প্রযোজ্য",
          "index": 2,
          "start_ms": 15730.0,
          "end_ms": 22750.0,
          "duration_ms": 7020.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: \\chi=V-E+F",
          "index": 3,
          "start_ms": 23100.0,
          "end_ms": 27975.0,
          "duration_ms": 4875.0
        },
        {
          "type": "p",
          "text": "এই কারণেই K₃,₃ সমতলে আঁকা যায় না কিন্তু টোরাসে যায় — পৃষ্ঠের χ বদলালে সীমাবদ্ধতাও বদলায়।",
          "index": 4,
          "start_ms": 28325.0,
          "end_ms": 36830.0,
          "duration_ms": 8505.0
        }
      ]
    },
    "sec-takeaway": {
      "title": "শিক্ষণীয় বিষয়",
      "audio_file": "sec_05_sec-takeaway.mp3",
      "total_duration_ms": 26345.0,
      "cues": [
        {
          "type": "h2",
          "text": "পঞ্চম পরিচ্ছেদ, শিক্ষণীয় বিষয়।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5260.0,
          "duration_ms": 5260.0
        },
        {
          "type": "p",
          "text": "একটি সূত্র মুখস্থ করার বদলে তার প্রমাণের গঠন বোঝা গণিতের আসল আনন্দ। স্প্যানিং ট্রি + এক-ধার-ফেরত — মাত্র দুটি ধাপে পুরো ফল।",
          "index": 1,
          "start_ms": 5610.0,
          "end_ms": 15875.0,
          "duration_ms": 10265.0
        },
        {
          "type": "p",
          "text": "এই কোর্সের ধাঁধাগুলোতে আমরা বারবার দেখেছি — সঠিক দৃষ্টিভঙ্গি বা ইনভ্যারিয়েন্ট খুঁজে পেলে কঠিনতা অদৃশ্য হয়ে যায়।",
          "index": 2,
          "start_ms": 16225.0,
          "end_ms": 25995.0,
          "duration_ms": 9770.0
        }
      ]
    }
  }
}