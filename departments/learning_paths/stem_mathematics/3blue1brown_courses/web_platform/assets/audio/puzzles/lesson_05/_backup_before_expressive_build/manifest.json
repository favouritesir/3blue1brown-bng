  "sections": {
    "sec-pattern": {
      "title": "প্রলোভনসংকুল প্যাটার্ন",
      "audio_file": "sec_01_sec-pattern.mp3",
      "total_duration_ms": 46145.0,
      "cues": [
        {
          "type": "h2",
          "text": "প্রথম পরিচ্ছেদ, প্রলোভনসংকুল প্যাটার্ন।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5645.0,
          "duration_ms": 5645.0
        },
        {
          "type": "p",
          "text": "বৃত্তের উপর n টি বিন্দু নিয়ে প্রতি জোড়াকে রেখা দিয়ে জোড়া দিন। সর্বোচ্চ কতগুলো অঞ্চল তৈরি হয়? প্রথম কয়েকটি উত্তর: ১, ২, ৪, ৮, ১৬।",
          "index": 1,
          "start_ms": 5995.0,
          "end_ms": 16865.0,
          "duration_ms": 10870.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, বৃত্তের বিন্দুগুলোকে জোড়া দেওয়া রেখাগুলো অঞ্চল তৈরি করে",
          "index": 2,
          "start_ms": 17215.0,
          "end_ms": 24950.0,
          "duration_ms": 7735.0
        },
        {
          "type": "p",
          "text": "স্বাভাবিকভাবেই মনে হয় পরবর্তী উত্তর ৩২ হবে। কিন্তু ৬টি বিন্দুর ক্ষেত্রে পাওয়া যায় ৩১ — প্যাটার্ন ভেঙে পড়ে।",
          "index": 3,
          "start_ms": 25300.0,
          "end_ms": 34850.0,
          "duration_ms": 9550.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: আশ্চর্য। ১, ২, ৪, ৮, ১৬, … ৩১ — প্রথম পাঁচটি ক্ষেত্রে ২-র ঘাত, ষষ্ঠে নয়। গণিতে এমন “ভাঙা প্যাটার্ন” অন্য কিছু শিখায়।",
          "index": 4,
          "start_ms": 35200.0,
          "end_ms": 45795.0,
          "duration_ms": 10595.0
        }
      ]
    },
    "sec-count": {
      "title": "সঠিক গণনা",
      "audio_file": "sec_02_sec-count.mp3",
      "total_duration_ms": 39545.0,
      "cues": [
        {
          "type": "h2",
          "text": "দ্বিতীয় পরিচ্ছেদ, সঠিক গণনা।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5095.0,
          "duration_ms": 5095.0
        },
        {
          "type": "p",
          "text": "প্রতিটি নতুন রেখা যতগুলো পুরনো রেখাকে ছেদ করে, ততগুলো নতুন অঞ্চল যোগ করে। মোট অঞ্চল = শুরুর ১ + রেখার সংখ্যা + ছেদবিন্দুর সংখ্যা।",
          "index": 1,
          "start_ms": 5445.0,
          "end_ms": 16040.0,
          "duration_ms": 10595.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, প্রতিটি ছেদবিন্দু নতুন অঞ্চল তৈরি করে",
          "index": 2,
          "start_ms": 16390.0,
          "end_ms": 23025.0,
          "duration_ms": 6635.0
        },
        {
          "type": "p",
          "text": "রেখার সংখ্যা C(n,2)। ছেদবিন্দুর সংখ্যা C(n,4) — কারণ যেকোনো চার বিন্দু থেকে ঠিক একটি ছেদবিন্দু পাওয়া যায়।",
          "index": 3,
          "start_ms": 23375.0,
          "end_ms": 32760.0,
          "duration_ms": 9385.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: R(n)=\\binom{n}{4}+\\binom{n}{2}+1",
          "index": 4,
          "start_ms": 33110.0,
          "end_ms": 39195.0,
          "duration_ms": 6085.0
        }
      ]
    },
    "sec-break": {
      "title": "কেন ৩২ নয়",
      "audio_file": "sec_03_sec-break.mp3",
      "total_duration_ms": 37400.0,
      "cues": [
        {
          "type": "h2",
          "text": "তৃতীয় পরিচ্ছেদ, কেন ৩২ নয়।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5040.0,
          "duration_ms": 5040.0
        },
        {
          "type": "p",
          "text": "n = 6-এ C(6,4) = 15, C(6,2) = 15। সুতরাং R = 15 + 15 + 1 = 31, 32 নয়।",
          "index": 1,
          "start_ms": 5390.0,
          "end_ms": 12740.0,
          "duration_ms": 7350.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, ১, ২, ৪, ৮, ১৬, ৩১ — ষষ্ঠ পদে ২-র ঘাত ভেঙে পড়ে",
          "index": 2,
          "start_ms": 13090.0,
          "end_ms": 20275.0,
          "duration_ms": 7185.0
        },
        {
          "type": "h3",
          "text": "গভীর কারণ",
          "index": 3,
          "start_ms": 20625.0,
          "end_ms": 24620.0,
          "duration_ms": 3995.0
        },
        {
          "type": "p",
          "text": "২-র ঘাত আসত যদি প্রতিটি নতুন বিন্দু আগের সব রেখাকে নতুনভাবে ছেদ করত। কিন্তু ৬টি বিন্দুতে কিছু ছেদ একই জায়গায় মিলে যায় — এই “সংঘর্ষ”-এই ৩২ কে ৩১ করে দেয়।",
          "index": 4,
          "start_ms": 24970.0,
          "end_ms": 37050.0,
          "duration_ms": 12080.0
        }
      ]
    },
    "sec-general": {
      "title": "সাধারণীকরণ",
      "audio_file": "sec_04_sec-general.mp3",
      "total_duration_ms": 34705.0,
      "cues": [
        {
          "type": "h2",
          "text": "চতুর্থ পরিচ্ছেদ, সাধারণীকরণ।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5040.0,
          "duration_ms": 5040.0
        },
        {
          "type": "p",
          "text": "মোজারের মূল প্রশ্ন ছিল বৃত্ত নয়, গোলক: গোলকের বিন্দুগুলোকে বড় বৃত্ত দিয়ে ভাগ করলে কতগুলো অঞ্চল? সেখানেও একই ধরনের বহুপদী উত্তর আসে।",
          "index": 1,
          "start_ms": 5390.0,
          "end_ms": 16260.0,
          "duration_ms": 10870.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, গোলকের উপর বৃহত্তম বৃত্ত দিয়ে পৃষ্ঠ ভাগ করা",
          "index": 2,
          "start_ms": 16610.0,
          "end_ms": 23630.0,
          "duration_ms": 7020.0
        },
        {
          "type": "p",
          "text": "এখানে শিক্ষা হলো — “প্যাটার্ন দেখে উত্তর বলা” এবং “গঠন বুঝে উত্তর বের করা” এক জিনিস নয়। দ্বিতীয়টি কঠিন, কিন্তু নির্ভরযোগ্য।",
          "index": 3,
          "start_ms": 23980.0,
          "end_ms": 34355.0,
          "duration_ms": 10375.0
        }
      ]
    },
    "sec-takeaway": {
      "title": "শিক্ষণীয় বিষয়",
      "audio_file": "sec_05_sec-takeaway.mp3",
      "total_duration_ms": 22990.0,
      "cues": [
        {
          "type": "h2",
          "text": "পঞ্চম পরিচ্ছেদ, শিক্ষণীয় বিষয়।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5260.0,
          "duration_ms": 5260.0
        },
        {
          "type": "p",
          "text": "গণিতবিদেরা প্যাটার্ন ভাঙাকে ব্যর্থতা হিসেবে দেখেন না; এটি নতুন গঠন আবিষ্কারের সংকেত।",
          "index": 1,
          "start_ms": 5610.0,
          "end_ms": 13730.0,
          "duration_ms": 8120.0
        },
        {
          "type": "p",
          "text": "পরবর্তী পাঠে আমরা দেখব কীভাবে উচ্চ মাত্রা ব্যবহার করে এ ধরনের জ্যামিতিক জটিলতা সরল করা যায়।",
          "index": 2,
          "start_ms": 14080.0,
          "end_ms": 22640.0,
          "duration_ms": 8560.0
        }
      ]
    }
  }
}