  "sections": {
    "sec-puzzle": {
      "title": "ধাঁধাটি",
      "audio_file": "sec_01_sec-puzzle.mp3",
      "total_duration_ms": 47685.0,
      "cues": [
        {
          "type": "h2",
          "text": "প্রথম পরিচ্ছেদ, ধাঁধাটি।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 4820.0,
          "duration_ms": 4820.0
        },
        {
          "type": "p",
          "text": "একটি ৮×৮ দাবার বোর্ডের ৬৪টি ঘরে প্রতিটিতে একটি মুদ্রা — মাথা বা লেজ। একজন “চাবি”র অবস্থান নির্দিষ্ট একটি ঘরে রেখে অন্যজনকে বলবেন। নিয়ম: সঙ্গী কেবল একটি মুদ্রা উল্টাতে পারেন।",
          "index": 1,
          "start_ms": 5170.0,
          "end_ms": 18240.0,
          "duration_ms": 13070.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, ৬৪টি ঘর — প্রতিটিতে মাথা বা লেজ",
          "index": 2,
          "start_ms": 18590.0,
          "end_ms": 24895.0,
          "duration_ms": 6305.0
        },
        {
          "type": "p",
          "text": "দ্বিতীয়জন বোর্ড দেখে কোন ঘরে চাবি আছে তা বলতে পারবেন কি? প্রথমে মনে হয় তথের অভাব আছে — কিন্তু একটিমাত্র উল্টানোতেই যথেষ্ট তথ্য লুকানো যায়।",
          "index": 3,
          "start_ms": 25245.0,
          "end_ms": 36500.0,
          "duration_ms": 11255.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: আশ্চর্য। ৬৪ = ২⁶। ছয়টি বিটেই ৬৪টি অবস্থান নির্দেশ করা যায় — আর একটি মুদ্রা উল্টানো ঠিক ছয়টি বিটের বার্তা বহন করে।",
          "index": 4,
          "start_ms": 36850.0,
          "end_ms": 47335.0,
          "duration_ms": 10485.0
        }
      ]
    },
    "sec-bits": {
      "title": "ঘরে নাম্বার ও বিট",
      "audio_file": "sec_02_sec-bits.mp3",
      "total_duration_ms": 41140.0,
      "cues": [
        {
          "type": "h2",
          "text": "দ্বিতীয় পরিচ্ছেদ, ঘরে নাম্বার ও বিট।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5535.0,
          "duration_ms": 5535.0
        },
        {
          "type": "p",
          "text": "প্রতিটি ঘরে ০ থেকে ৬৩ পর্যন্ত একটি নাম্বার দিন। ৬ বিটের দ্বিমিক রূপে এই নাম্বারগুলো লিখুন — প্রতিটি বিট একটি “প্রশ্ন” যার উত্তর হলো ওই বিটের মান।",
          "index": 1,
          "start_ms": 5885.0,
          "end_ms": 17360.0,
          "duration_ms": 11475.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, ৬টি বিট দিয়ে ০–৬৩ নাম্বার এনকোড করা",
          "index": 2,
          "start_ms": 17710.0,
          "end_ms": 24290.0,
          "duration_ms": 6580.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: 64=2^{6}\\quad\\Rightarrow\\quad 6\\ \\text{bits}",
          "index": 3,
          "start_ms": 24640.0,
          "end_ms": 31385.0,
          "duration_ms": 6745.0
        },
        {
          "type": "p",
          "text": "মুদ্রার অবস্থা ব্যবহার করে আমরা ছয়টি প্রশ্নের উত্তর পাই; সেগুলো নিয়ে একটি ৬-বিটের নাম্বার গড়ে ওঠে।",
          "index": 4,
          "start_ms": 31735.0,
          "end_ms": 40790.0,
          "duration_ms": 9055.0
        }
      ]
    },
    "sec-xor": {
      "title": "এক্স-অর-এর যাদু",
      "audio_file": "sec_03_sec-xor.mp3",
      "total_duration_ms": 51315.0,
      "cues": [
        {
          "type": "h2",
          "text": "তৃতীয় পরিচ্ছেদ, এক্স-অর-এর যাদু।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5315.0,
          "duration_ms": 5315.0
        },
        {
          "type": "p",
          "text": "যে ঘরগুলোতে মাথা আছে, তাদের নাম্বারগুলোর এক্স-অর (বিট-ভিত্তিক যোগ, ক্যারি ছাড়া) বের করুন। ফলাফল একটি ৬-বিটের নাম্বার S — বর্তমান বার্তা।",
          "index": 1,
          "start_ms": 5665.0,
          "end_ms": 16700.0,
          "duration_ms": 11035.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, মাথা-ঘরগুলোর নাম্বারের এক্স-অর",
          "index": 2,
          "start_ms": 17050.0,
          "end_ms": 23300.0,
          "duration_ms": 6250.0
        },
        {
          "type": "p",
          "text": "চাবি আছে এমন ঘরের নাম্বার T। প্রথমজন সেই ঘরটি খুঁজেন যার নাম্বার S ⊕ T; সেখানকার মুদ্রা উল্টালে নতুন এক্স-অর হয় ঠিক T।",
          "index": 3,
          "start_ms": 23650.0,
          "end_ms": 33695.0,
          "duration_ms": 10045.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: S \\oplus (S \\oplus T) = T",
          "index": 4,
          "start_ms": 34045.0,
          "end_ms": 39745.0,
          "duration_ms": 5700.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: কেন কাজ করে। একটি মুদ্রা উল্টালে সেই ঘরের নাম্বারটি এক্স-অর-এর সাথে যোগ বা বাদ যায় — ফলে ঠিক T পাওয়া যায়, অন্য কিছু নয়।",
          "index": 5,
          "start_ms": 40095.0,
          "end_ms": 50965.0,
          "duration_ms": 10870.0
        }
      ]
    },
    "sec-proof": {
      "title": "সম্পূর্ণ প্রক্রিয়া",
      "audio_file": "sec_04_sec-proof.mp3",
      "total_duration_ms": 32780.0,
      "cues": [
        {
          "type": "h2",
          "text": "চতুর্থ পরিচ্ছেদ, সম্পূর্ণ প্রক্রিয়া।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5535.0,
          "duration_ms": 5535.0
        },
        {
          "type": "p",
          "text": "ধাপ ১: মাথা-ঘরগুলোর এক্স-অর বের করুন (S)। ধাপ ২: X = S ⊕ T নির্ণয় করুন। ধাপ ৩: X নাম্বারের ঘরের মুদ্রা উল্টান। দ্বিতীয়জন একই হিসাব করে T পড়েন।",
          "index": 1,
          "start_ms": 5885.0,
          "end_ms": 17360.0,
          "duration_ms": 11475.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, তিন ধাপে বার্তা এনকোড ও ডিকোড",
          "index": 2,
          "start_ms": 17710.0,
          "end_ms": 23905.0,
          "duration_ms": 6195.0
        },
        {
          "type": "p",
          "text": "কোনো অতিরিক্ত চুক্তি বা আগের বিন্যাস লাগে না — কেবল গণিতের একটি সুন্দর একটি সরল কৌশল।",
          "index": 3,
          "start_ms": 24255.0,
          "end_ms": 32430.0,
          "duration_ms": 8175.0
        }
      ]
    },
    "sec-takeaway": {
      "title": "শিক্ষণীয় বিষয়",
      "audio_file": "sec_05_sec-takeaway.mp3",
      "total_duration_ms": 25575.0,
      "cues": [
        {
          "type": "h2",
          "text": "পঞ্চম পরিচ্ছেদ, শিক্ষণীয় বিষয়।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5260.0,
          "duration_ms": 5260.0
        },
        {
          "type": "p",
          "text": "“অসম্ভব” মনে হওয়া তথ্য-সমস্যা প্রায়ই একটি উপযুক্ত কোডিংয়ে রূপান্তরিত হয়। ২-র ঘাত, দ্বিমিক ব্যবস্থা ও এক্স-অর — এই তিনটি টুল অনেক ধাঁধার চাবি।",
          "index": 1,
          "start_ms": 5610.0,
          "end_ms": 17085.0,
          "duration_ms": 11475.0
        },
        {
          "type": "p",
          "text": "পরবর্তী পাঠে আমরা দেখব কীভাবে একই ধরনের সীমাবদ্ধতা গ্রাফ-অঙ্কনে নতুন রূপ নেয়।",
          "index": 2,
          "start_ms": 17435.0,
          "end_ms": 25225.0,
          "duration_ms": 7790.0
        }
      ]
    }
  }
}