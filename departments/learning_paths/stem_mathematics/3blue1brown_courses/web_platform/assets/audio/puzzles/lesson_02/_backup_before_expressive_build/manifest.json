      "total_duration_ms": 27555.0,
      "cues": [
        {
          "type": "h2",
          "text": "পঞ্চম পরিচ্ছেদ, দুটি শিক্ষণীয় কৌশল।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5480.0,
          "duration_ms": 5480.0
        },
        {
          "type": "p",
          "text": "প্রথম: যতক্ষণ না হাতে কোনো আঁধার ধরা পড়ে, ততক্ষণ প্রশ্নটিকে সরল সংস্করণে নামিয়ে আনুন। দ্বিতীয়: কাজে লাগা নির্মাণকে প্রশ্নের ভিত্তি বানান।",
          "index": 1,
          "start_ms": 5830.0,
          "end_ms": 17030.0,
          "duration_ms": 11200.0
        },
        {
          "type": "p",
          "text": "ভুল উপায়ে হিসাব করলে ত্রিমাত্রিক ক্ষেত্রে জটিল পৃষ্ঠ-সমাকলন আসে; সঠিক দৃষ্টিভঙ্গিতে উত্তর কয়েক লাইনে পাওয়া যায়।",
          "index": 2,
          "start_ms": 17380.0,
          "end_ms": 27205.0,
          "duration_ms": 9825.0
        }
      ]
