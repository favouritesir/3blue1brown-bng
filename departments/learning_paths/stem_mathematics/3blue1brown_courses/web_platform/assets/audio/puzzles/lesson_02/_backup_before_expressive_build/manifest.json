      "audio_file": "sec_03_sec-reframe.mp3",
      "total_duration_ms": 54945.0,
      "cues": [
        {
          "type": "h2",
          "text": "তৃতীয় পরিচ্ছেদ, দৃষ্টিভঙ্গির স্থানান্তর।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5755.0,
          "duration_ms": 5755.0
        },
        {
          "type": "p",
          "text": "১/৪ সংখ্যাটি সন্দেহজনকভাবে পরিচ্ছন্ন। এর পেছনে কী আছে? প্রশ্নটি নতুনভাবে গঠন করুন: আগে কেন্দ্র দিয়ে দুটি এলোমেলো রেখা বাছুন, তারপর প্রতিটি রেখার দুটি ছেদবিন্দুর মধ্যে মুদ্রা উঠিয়ে বিন্দু বাছুন।",
          "index": 1,
          "start_ms": 6105.0,
          "end_ms": 20330.0,
          "duration_ms": 14225.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, প্রতিটি রেখার জন্য দুটি নমুনা বিন্দু — মুদ্রা উঠিয়ে একটি বাছা হয়",
          "index": 2,
          "start_ms": 20680.0,
          "end_ms": 28910.0,
          "duration_ms": 8230.0
        },
        {
          "type": "h3",
          "text": "কেন এটি কাজ করে",
          "index": 3,
          "start_ms": 29260.0,
          "end_ms": 33585.0,
          "duration_ms": 4325.0
        },
        {
          "type": "p",
          "text": "মুদ্রা উঠানোর চারটি সমান সম্ভাব্য ফলাফলের মাত্র একটি P₁ ও P₂-কে P₃-র বিপরীত দিকে রাখে। রেখা যেমনই হোক, সম্ভাবনা সবসময় ১/৪ — কোনো জটিল সমাকলন ছাড়াই।",
          "index": 4,
          "start_ms": 33935.0,
          "end_ms": 45630.0,
          "duration_ms": 11695.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: মূল কৌশল। কোনো নির্মাণ কাজে লাগলে পুরো প্রশ্নটিকে সেই নির্মাণের ভাষায় আবার লিখুন।",
          "index": 5,
          "start_ms": 45980.0,
          "end_ms": 54595.0,
          "duration_ms": 8615.0
        }
      ]
    },
