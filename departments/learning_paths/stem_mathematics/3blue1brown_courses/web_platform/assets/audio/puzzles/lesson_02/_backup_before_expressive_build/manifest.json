    "sec-problem": {
      "title": "পুটনামের কঠিনতম প্রশ্ন",
      "audio_file": "sec_01_sec-problem.mp3",
      "total_duration_ms": 52085.0,
      "cues": [
        {
          "type": "h2",
          "text": "প্রথম পরিচ্ছেদ, পুটনামের কঠিনতম প্রশ্ন।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5645.0,
          "duration_ms": 5645.0
        },
        {
          "type": "p",
          "text": "আমেরিকার বিশ্ববিদ্যালয়-স্তরের পুটনাম প্রতিযোগিতা তার কঠিনতার জন্য বিখ্যাত। ১৯৯২ সালের A6 নম্বর প্রশ্নটি ছিল এরকমই এক কঠিন প্রশ্ন।",
          "index": 1,
          "start_ms": 5995.0,
          "end_ms": 16645.0,
          "duration_ms": 10650.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, গোলকের পৃষ্ঠে এলোমেলোভাবে বাছা চারটি বিন্দু",
          "index": 2,
          "start_ms": 16995.0,
          "end_ms": 23960.0,
          "duration_ms": 6965.0
        },
        {
          "type": "h3",
          "text": "মূল প্রশ্ন",
          "index": 3,
          "start_ms": 24310.0,
          "end_ms": 28360.0,
          "duration_ms": 4050.0
        },
        {
          "type": "p",
          "text": "গোলকের পৃষ্ঠে স্বাধীনভাবে ও সমান সম্ভাবনায় চারটি বিন্দু বাছা হলো। এই চার বিন্দুকে শীর্ষবিন্দু ধরে গড়ে ওঠা টেট্রাহেড্রনের ভেতরে গোলকের কেন্দ্র থাকার সম্ভাবনা কত?",
          "index": 4,
          "start_ms": 28710.0,
          "end_ms": 41120.0,
          "duration_ms": 12410.0
        },
        {
          "type": "callout",
          "text": "বিশেষ নোট: প্রথম ধাপ। সরাসরি ত্রিমাত্রিক হিসাব না করে প্রশ্নটিকে আগে দ্বিমাত্রিকে নামিয়ে আনুন — একটি বৃত্ত ও তিনটি বিন্দু।",
          "index": 5,
          "start_ms": 41470.0,
          "end_ms": 51735.0,
          "duration_ms": 10265.0
        }
      ]
    },
    "sec-2d": {
      "title": "দ্বিমাত্রিক ক্ষেত্র: ১/৪",
      "audio_file": "sec_02_sec-2d.mp3",
      "total_duration_ms": 53185.0,
      "cues": [
        {
          "type": "h2",
          "text": "দ্বিতীয় পরিচ্ছেদ, দ্বিমাত্রিক ক্ষেত্র: ১/৪।",
          "index": 0,
          "start_ms": 0.0,
          "end_ms": 5920.0,
          "duration_ms": 5920.0
        },
        {
          "type": "p",
          "text": "বৃত্তের উপর তিনটি এলোমেলো বিন্দু বাছুন। কোন অবস্থানে ত্রিভুজটি কেন্দ্র ধারণ করবে? প্রথম দুটি বিন্দু স্থির রেখে তৃতীয়টির অবস্থান দেখুন।",
          "index": 1,
          "start_ms": 6270.0,
          "end_ms": 17195.0,
          "duration_ms": 10925.0
        },
        {
          "type": "figure",
          "text": "চিত্রে দেখা যাচ্ছে, প্রথম দুটি বিন্দু থেকে কেন্দ্র দিয়ে টানা রেখা বৃত্তকে ভাগ করে চারটি চাপে",
          "index": 2,
          "start_ms": 17545.0,
          "end_ms": 26160.0,
          "duration_ms": 8615.0
        },
        {
          "type": "p",
          "text": "P₁ ও P₂ থেকে কেন্দ্রের মধ্য দিয়ে রেখা টানলে বৃত্ত চারটি চাপে ভাগ হয়। কেবল ঠিক বিপরীত চাপে P₃ থাকলে ত্রিভুজ কেন্দ্র ধারণ করে।",
          "index": 3,
          "start_ms": 26510.0,
          "end_ms": 36940.0,
          "duration_ms": 10430.0
        },
        {
          "type": "formula-box",
          "text": "গাণিতিক সূত্র: P(\\text{centre in triangle})=\\frac14",
          "index": 4,
          "start_ms": 37290.0,
          "end_ms": 43595.0,
          "duration_ms": 6305.0
        },
        {
          "type": "p",
          "text": "P₁ ও P₂-র মধ্যকার কোণ যতই হোক, গড়ে ওই চাপটি পুরো বৃত্তের এক-চতুর্থাংশ। তাই দ্বিমাত্রিক উত্তর ১/৪।",
          "index": 5,
          "start_ms": 43945.0,
          "end_ms": 52835.0,
          "duration_ms": 8890.0
        }
      ]
    },
