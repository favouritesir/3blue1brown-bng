[
  {
    "text": "পেন, পেন, পেন",
    "start": 0.0,
    "end": 1.5
  },
  {
    "text": "দে!",
    "start": 1.5,
    "end": 2.5
  },
  {
    "text": "দেখো, একটা বই, একটা সুন্দর বই।",
    "start": 3.5,
    "end": 7.5
  },
  {
    "text": "বুক, বুক, হ্যাঁ",
    "start": 7.5,
    "end": 10.0
  },
  {
    "text": "বুক, বই, বুক, বুক",
    "start": 11.0,
    "end": 14.5
  },
  {
    "text": "ওহ! দেখো, একটা স্কুল ব্যাগ।",
    "start": 15.5,
    "end": 18.5
  },
  {
    "text": "বাহ! ব্যাগ, ব্যাগ, ব্যাগ",
    "start": 18.5,
    "end": 21.5
  },
  {
    "text": "হ্যাঁ, এটা একটা স্কুল ব্যাগ। এই ব্যাগ, ব্যাগ, ব্যাগ",
    "start": 23.5,
    "end": 27.5
  },
  {
    "text": "এটা কি বলতো? হাহাহাহা! দেখো কাগজ",
    "start": 28.5,
    "end": 32.5
  }
]